---
// A code sample with its file name above it, highlighted at build time.
import { Code } from 'astro:components';

interface Props {
	code: string;
	lang: 'java' | 'yaml' | 'xml';
	file: string;
}

const { code, lang, file } = Astro.props;
---

<div class="code-block">
	<div class="code-file">{file}</div>
	<Code code={code} lang={lang} theme="github-dark-default" />
</div>
