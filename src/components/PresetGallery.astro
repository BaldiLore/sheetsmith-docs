---
import SheetPreview from './SheetPreview.astro';
import { ACCENTS } from '../lib/preset.js';
import { t, pageLang } from '../lib/i18n.js';

const lang = pageLang(Astro);
const presets = (['LIGHT', 'MEDIUM', 'DARK'] as const).map((id) => ({ id, text: t(lang, `gallery.${id}`) }));
const initial = ACCENTS[0].value;
---

<div class="gallery not-content" data-gallery>
	<fieldset class="accents">
		<legend>{t(lang, 'gallery.accent')}</legend>
		{ACCENTS.map((a) => (
			<button type="button" class="swatch" data-accent={a.value} aria-pressed={String(a.value === initial)}>
				<span class="dot" style={`background:${a.value}`}></span>
				<span class="name">{t(lang, `accent.${a.value}`)}</span>
				<code>{a.value}</code>
			</button>
		))}
		<label class="custom">
			<input type="color" value={initial} data-custom aria-label={t(lang, 'gallery.customLabel')} />
			<span>{t(lang, 'gallery.custom')}</span>
		</label>
	</fieldset>

	<div class="grid">
		{presets.map((p) => (
			<section class="item">
				<h3><code>TablePreset.{p.id}</code></h3>
				<p>{p.text}</p>
				<SheetPreview preset={p.id} accent={initial} />
			</section>
		))}
	</div>
</div>

<script>
	import { presetVars } from '../lib/preset.js';

	for (const root of document.querySelectorAll<HTMLElement>('[data-gallery]')) {
		const sheets = root.querySelectorAll<HTMLElement>('.sheet');
		const buttons = root.querySelectorAll<HTMLButtonElement>('[data-accent]');
		const custom = root.querySelector<HTMLInputElement>('[data-custom]');

		const apply = (accent: string) => {
			for (const sheet of sheets) {
				const vars = presetVars(sheet.dataset.preset, accent);
				for (const [k, v] of Object.entries(vars)) sheet.style.setProperty(k, v as string);
			}
			for (const b of buttons) b.setAttribute('aria-pressed', String(b.dataset.accent === accent.toUpperCase()));
		};

		for (const b of buttons) b.addEventListener('click', () => apply(b.dataset.accent!));
		custom?.addEventListener('input', () => apply(custom.value.toUpperCase()));
	}
</script>

<style>
	.gallery {
		margin-block: 1.5rem;
	}
	.accents {
		display: flex;
		flex-wrap: wrap;
		gap: 0.5rem;
		margin: 0 0 1.5rem;
		padding: 0;
		border: 0;
	}
	legend {
		width: 100%;
		margin-bottom: 0.5rem;
		font-weight: 600;
		color: var(--sl-color-white);
	}
	.swatch,
	.custom {
		display: inline-flex;
		align-items: center;
		gap: 0.5rem;
		padding: 0.4rem 0.75rem 0.4rem 0.5rem;
		border: 1px solid var(--sl-color-gray-5);
		border-radius: 999px;
		background: var(--sl-color-bg);
		color: var(--sl-color-gray-2);
		font: inherit;
		font-size: var(--sl-text-sm);
		cursor: pointer;
	}
	.swatch[aria-pressed='true'] {
		border-color: var(--sl-color-text-accent);
		color: var(--sl-color-white);
		box-shadow: inset 0 0 0 1px var(--sl-color-text-accent);
	}
	.swatch:focus-visible,
	.custom:focus-within {
		outline: 2px solid var(--sl-color-text-accent);
		outline-offset: 2px;
	}
	.dot {
		width: 1rem;
		height: 1rem;
		border-radius: 50%;
		box-shadow: inset 0 0 0 1px rgb(0 0 0 / 0.15);
	}
	.swatch code {
		font-size: 0.75rem;
		color: var(--sl-color-gray-3);
		background: none;
		padding: 0;
	}
	.custom input {
		width: 1.25rem;
		height: 1.25rem;
		padding: 0;
		border: 0;
		background: none;
		cursor: pointer;
	}
	.grid {
		display: grid;
		gap: 2rem;
	}
	.item h3 {
		margin: 0 0 0.25rem;
		font-size: var(--sl-text-lg);
		color: var(--sl-color-white);
	}
	.item h3 code {
		background: none;
		padding: 0;
		font-size: inherit;
	}
	.item p {
		margin: 0 0 0.75rem;
		color: var(--sl-color-gray-2);
	}
</style>
